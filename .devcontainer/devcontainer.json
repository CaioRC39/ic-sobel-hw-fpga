{
    "name": "SystemVerilog + OpenClaude",
    "image": "ubuntu:24.04",
    "runArgs": [
        "--name",
        "sv-dev"
    ],
    "remoteEnv": {
        "LANG": "C.UTF-8"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "mshr-h.veriloghdl",
                "bmpenuelas.systemverilog-formatter-vscode"
                // A extensão oficial do OpenClaude ainda não está no Marketplace,
                // mas você pode instalar manualmente depois se quiser a UI gráfica
            ]
        }
    },
    "postAttachCommand": "echo '✅ SystemVerilog + OpenClaude pronto! Rode \"openclaude\" no terminal.'"
}