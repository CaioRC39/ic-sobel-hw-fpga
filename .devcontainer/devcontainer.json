{
    "name": "SystemVerilog",
    "image": "ubuntu:24.04",
    "runArgs": [
        "--name",
        "sv-dev"
    ],
    "remoteEnv": {
        "LANG": "C.UTF-8"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "mshr-h.veriloghdl",
                "bmpenuelas.systemverilog-formatter-vscode"
            ]
        }
    },
    "postAttachCommand": "echo '✅ Container pronto! LaTeX, Verilator e cocotb estão disponíveis.'"
}