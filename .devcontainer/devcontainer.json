{
    "name": "SystemVerilog",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "mshr-h.veriloghdl",
                "bmpenuelas.systemverilog-formatter-vscode",
                "james-yu.latex-workshop"
            ]
        }
    },
    "postAttachCommand": "echo '✅ Container pronto! LaTeX, Verilator e cocotb estão disponíveis.'"
}