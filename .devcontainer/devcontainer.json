{
    "name": "SystemVerilog",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "remoteUser": "vscode",
    "mounts": [
        "source=quartus-install,target=/opt/intelFPGA_lite,type=volume",
        "source=${localEnv:HOME}/.licenses/questa/license.dat,target=/opt/questa-license/license.dat,type=bind,readonly"
    ],
    "containerEnv": {
        "SALT_LICENSE_SERVER": "/opt/questa-license/license.dat"
    },
    "runArgs": [
        "--mac-address=${localEnv:QUESTA_MAC}"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "mshr-h.veriloghdl",
                "bmpenuelas.systemverilog-formatter-vscode",
                "james-yu.latex-workshop"
            ]
        }
    },
    "postAttachCommand": "echo '✅ Container pronto!'"
}